  "triggers": [
    {
      "when": {
        "start": true
      },
      "do": [
        {
          "say": "RED DAWN. Parachutes over Mariehem."
        },
        {
          "objective": "Paratroopers are landing! Grab a gun at the school, then run for the old gravel pit."
        },
        {
          "spawn": "paratroopers"
        }
      ]
    },
    {
      "when": {
        "enter": "school"
      },
      "do": [
        {
          "say": "Guns on the ground here. Take what you can carry, then go. They will be here soon."
        }
      ]
    },
    {
      "name": "arrive",
      "when": {
        "enter": "hideout"
      },
      "do": [
        {
          "say": "WOLVERINES!"
        },
        {
          "objective": "Ambush the supply convoy on the highway."
        },
        {
          "spawn": "convoy"
        }
      ]
    },
    {
      "when": {
        "done": "arrive"
      },
      "wait": 50,
      "do": [
        {
          "say": "A patrol is sweeping the woods towards the pit. Hold the hideout!"
        },
        {
          "spawn": "scouts"
        }
      ]
    },
    {
      "when": {
        "enter": "hideout",
        "by": "scouts"
      },
      "do": [
        {
          "lose": "The hideout was found. The occupation goes on."
        }
      ]
    },
    {
      "name": "convoy-down",
      "when": {
        "cleared": "convoy"
      },
      "wait": 4,
      "do": [
        {
          "say": "The convoy burns. Their headquarters is next."
        },
        {
          "objective": "Raid the headquarters at the old supermarket."
        },
        {
          "spawn": "garrison"
        }
      ]
    },
    {
      "when": {
        "enter": "headquarters"
      },
      "do": [
        {
          "say": "Headquarters ahead. Expect a tank."
        }
      ]
    },
    {
      "when": {
        "cleared": "garrison"
      },
      "do": [
        {
          "win": "The headquarters falls. Mariehem is free. WOLVERINES!"
        }
      ]
    },
    {
      "when": {
        "after": 360
      },
      "do": [
        {
          "say": "More transports overhead. Reinforcements are landing."
        },
        {
          "spawn": "reinforcements"
        }
      ]
    },
    {
      "when": {
        "after": 1800
      },
      "do": [
        {
          "lose": "Dawn broke on an occupied town."
        }
      ]
    }
  ]
}